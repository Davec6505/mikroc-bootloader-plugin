{
  "name": "xc-project-importer",
  "displayName": "XC PIC32MX/MZ Project Importer & Creator for VS Code",
  "description": "Create new XC32 projects OR import existing MPLABX projects for PIC32MX/MZ. AI-assisted embedded development with GitHub Copilot. Visual config editor, MCC Harmony 3 compatible, build & flash from VS Code.",
  "version": "2.5.36",
  "publisher": "DavidCoetzee",
  "icon": "images/icon.png",
  "author": {
    "name": "Dave C"
  },
  "license": "MIT",
  "readme": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Davec6505/mikroc-bootloader-plugin"
  },
  "bugs": {
    "url": "https://github.com/Davec6505/mikroc-bootloader-plugin/issues"
  },
  "homepage": "https://github.com/Davec6505/mikroc-bootloader-plugin#readme",
  "keywords": [
    "xc32",
    "pic32",
    "mplabx",
    "embedded",
    "microchip",
    "harmony",
    "mcc",
    "copilot",
    "ai",
    "pic",
    "pic32",
    "avr",
    "arm",
    "mikroc",
    "bootloader",
    "microcontroller",
    "importer"
  ],
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pic32-ide.importMPLABX",
        "title": "XC PIC32: Import MPLABX Project or Create New Project"
      },
      {
        "command": "pic32-ide.importMikroC",
        "title": "XC Project Importer: Import MikroC Project"
      },
      {
        "command": "pic32-ide.flash",
        "title": "XC Project Importer: Flash Device (Bootloader)"
      },
      {
        "command": "pic32-ide.programDevice",
        "title": "XC Project Importer: Program Device via ICSP (ipecmd)"
      },
      {
        "command": "pic32-ide.build",
        "title": "XC Project Importer: Build Project"
      },
      {
        "command": "pic32-ide.updateBootloader",
        "title": "XC Project Importer: Check for Bootloader Updates"
      },
      {
        "command": "pic32-ide.addToPath",
        "title": "XC Project Importer: Add Bundled Tools to PATH"
      },
      {
        "command": "pic32-ide.cleanupPath",
        "title": "XC Project Importer: Clean Up Duplicate PATH Entries"
      }
    ],
    "configuration": {
      "title": "PIC32 IDE for VS Code",
      "properties": {
        "pic32-ide.makeToolPath": {
          "type": "string",
          "default": "",
          "description": "Path to GNU Make executable (leave empty to use bundled)"
        },
        "pic32m-dev.hexFilePattern": {
          "type": "string",
          "default": "**/*.hex",
          "description": "Glob pattern to find .hex files in workspace"
        },
        "pic32m-dev.showStatusBarButton": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Flash PIC32' button in the status bar for quick access"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-templates && npm run copy-webview",
    "copy-templates": "node -e \"require('fs').cpSync('src/templates', 'out/templates', {recursive: true})\"",
    "copy-webview": "node -e \"require('fs').cpSync('src/webview', 'out/webview', {recursive: true})\"",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  }
}
