{
    "family": "PIC32MX (General Purpose)",
    "description": "32-bit MIPS processors, 40-120MHz, USB/Ethernet/CAN variants",
    "configBits": {
        "default": [
        "// DEVCFG3 - Device Configuration Register 3",
        "#pragma config USERID = 0xFFFF          // User ID bits (default = 0xFFFF)",
        "#pragma config PMDL1WAY = OFF           // Peripheral Module Disable (OFF = Allow multiple reconfigurations)",
        "#pragma config IOL1WAY = OFF            // Peripheral Pin Select (OFF = Allow multiple reconfigurations)",
        "#pragma config FUSBIDIO = OFF           // USB USBID pin (OFF = Controlled by port I/O)",
        "#pragma config FVBUSONIO = OFF          // USB VBUS_ON pin (OFF = Controlled by port I/O)",
        "",
        "// DEVCFG2 - PLL and Clock Configuration (8MHz crystal → 80MHz system clock)",
        "#pragma config FPLLIDIV = DIV_2         // PLL Input Divider (8MHz ÷ 2 = 4MHz to PLL)",
        "#pragma config FPLLMULT = MUL_20        // PLL Multiplier (4MHz × 20 = 80MHz system clock)",
        "#pragma config FPLLODIV = DIV_1         // PLL Output Divider (80MHz ÷ 1 = 80MHz)",
        "#pragma config UPLLIDIV = DIV_2         // USB PLL Input Divider (÷ 2)",
        "#pragma config UPLLEN = OFF             // USB PLL (OFF = Disabled, not using USB in this template)",
        "",
        "// DEVCFG1 - Oscillator and Peripheral Bus Configuration",
        "#pragma config FNOSC = PRIPLL           // Oscillator Selection (PRIPLL = Primary oscillator with PLL)",
        "#pragma config FSOSCEN = OFF            // Secondary Oscillator (OFF = Disabled)",
        "#pragma config IESO = OFF               // Internal/External Switchover (OFF = Disabled)",
        "#pragma config POSCMOD = XT             // Primary Oscillator Mode (XT = Crystal oscillator mode)",
        "#pragma config OSCIOFNC = OFF           // CLKO Output (OFF = Disabled on OSC2 pin)",
        "#pragma config FPBDIV = DIV_1           // Peripheral Bus Clock (80MHz ÷ 1 = 80MHz PBCLK)",
        "#pragma config FCKSM = CSDCMD           // Clock Switching & Monitor (CSDCMD = Both disabled)",
        "#pragma config WDTPS = PS1048576        // Watchdog Postscaler (1:1048576 = longest timeout)",
        "#pragma config WINDIS = OFF             // Watchdog Window Mode (OFF = Disabled)",
        "#pragma config FWDTEN = OFF             // Watchdog Timer (OFF = Disabled, prevents unexpected resets)",
        "#pragma config FWDTWINSZ = WINSZ_25     // Watchdog Window Size (25%)",
        "",
        "// DEVCFG0 - Debug and Code Protection",
        "#pragma config DEBUG = ON               // Debugger Enable (ON = Debugging enabled for MPLAB/ICD)",
        "#pragma config JTAGEN = OFF             // JTAG Port (OFF = JTAG disabled)",
        "#pragma config ICESEL = ICS_PGx2        // ICD/ICE Pins (ICS_PGx2 = Communicate on PGEC2/PGED2)",
        "#pragma config PWP = OFF                // Program Flash Write Protect (OFF = Disabled)",
        "#pragma config BWP = OFF                // Boot Flash Write Protect (OFF = Disabled)",
        "#pragma config CP = OFF                 // Code Protect (OFF = Code protection disabled)"
    ]
    },
