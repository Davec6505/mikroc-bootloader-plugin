{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "\"{{MAKE_COMMAND}}\"",
            "args": [],
            "options": {
                "env": {
                    "PATH": "{{MAKE_BIN_DIR}};${env:PATH}",
                    "SHELL": "{{SH_PATH}}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "xc32",
                "fileLocation": ["relative", "${workspaceFolder}/srcs"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "\"{{MAKE_COMMAND}}\"",
            "args": ["debug"],
            "options": {
                "env": {
                    "PATH": "{{MAKE_BIN_DIR}};${env:PATH}",
                    "SHELL": "{{SH_PATH}}"
                }
            },
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "\"{{MAKE_COMMAND}}\"",
            "args": ["clean"],
            "options": {
                "env": {
                    "PATH": "{{MAKE_BIN_DIR}};${env:PATH}",
                    "SHELL": "{{SH_PATH}}"
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "\"{{MAKE_COMMAND}}\"",
            "args": ["rebuild"],
            "options": {
                "env": {
                    "PATH": "{{MAKE_BIN_DIR}};${env:PATH}",
                    "SHELL": "{{SH_PATH}}"
                }
            },
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Flash via Bootloader",
            "type": "shell",
            "command": "\"{{MAKE_COMMAND}}\"",
            "args": ["flash"],
            "options": {
                "env": {
                    "PATH": "{{MAKE_BIN_DIR}};${env:PATH}",
                    "SHELL": "{{SH_PATH}}"
                }
            },
            "group": "test",
            "dependsOn": ["Build"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Info",
            "type": "shell",
            "command": "\"{{MAKE_COMMAND}}\"",
            "args": ["info"],
            "options": {
                "env": {
                    "PATH": "{{MAKE_BIN_DIR}};${env:PATH}",
                    "SHELL": "{{SH_PATH}}"
                }
            },
            "group": "none",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
